+// --multi-jobs FILE (img_gen): one context (the H3 blocks in libxpu_h3, text encoder and VAE load once), then each
+// line, a JSON array of extra arguments, is parsed together with this command line as a separate run would parse it,
+// generated and saved. Inputs are loaded right before each job and freed after it; a failed job is logged and skipped.
+static int run_multi_jobs(int argc, const char* argv[], const SDCliParams& base_cli, SDContextParams& base_ctx) {
+    using clock = std::chrono::steady_clock;
+    auto secs   = [](clock::time_point t) { return std::chrono::duration<double>(clock::now() - t).count(); };
+    if (base_cli.mode != IMG_GEN) {
+        LOG_ERROR("--multi-jobs needs -M img_gen");
+        return 1;
+    }
+    std::vector<std::string> base_args;
+    for (int i = 0; i < argc; ++i) {
+        if (std::string(argv[i]) == "--multi-jobs") {
+            ++i;
+            continue;
+        }
+        base_args.push_back(argv[i]);
+    }
+    std::ifstream file(base_cli.multi_jobs_path);
+    if (!file) {
+        LOG_ERROR("cannot open --multi-jobs file '%s'", base_cli.multi_jobs_path.c_str());
+        return 1;
+    }
+    struct Job {
+        SDCliParams cli;
+        SDContextParams ctx;
+        SDGenerationParams gen;
+    };
+    std::vector<std::vector<std::string>> lines;
+    std::string line;
+    int line_no = 0;
+    while (std::getline(file, line)) {
+        ++line_no;
+        const size_t first = line.find_first_not_of(" \t\r");
+        if (first == std::string::npos || line[first] == '#') {
+            continue;
+        }
+        std::vector<std::string> args = base_args;
+        try {
+            auto parsed = nlohmann::json::parse(line);
+            if (!parsed.is_array()) {
+                throw std::runtime_error("not a JSON array");
+            }
+            for (const auto& item : parsed) {
+                args.push_back(item.get<std::string>());
+            }
+        } catch (const std::exception& e) {
+            LOG_ERROR("--multi-jobs line %d: %s", line_no, e.what());
+            return 1;
+        }
+        lines.push_back(std::move(args));
+    }
+    if (lines.empty()) {
+        LOG_ERROR("--multi-jobs file '%s' has no jobs", base_cli.multi_jobs_path.c_str());
+        return 1;
+    }
+    // Phase batching (default; SD_MULTI_PHASES=0: one image after another as before): pass 1 runs every job up to its
+    // conditioning (text encoder, reference VAE encodes; both cached in the context), pass 2 runs every job again from
+    // the caches, so the offloaded text encoder visits the card once a batch and the DiT blocks stay resident between
+    // images instead of being reloaded for each (SD_XPU_H3_KEEP). Same seeds, same maths: the images are the same.
+    const char* ph   = std::getenv("SD_MULTI_PHASES");
+    const bool phases = ph == nullptr || std::string(ph) != "0";
+    if (phases) {
+        const int want = static_cast<int>(lines.size()) * 3 + 4;  // cond, uncond and image-uncond entries per job
+        base_ctx.conditioning_cache_size = std::max(base_ctx.conditioning_cache_size.value_or(4), want);
+    }
+    const auto load_start = clock::now();
+    SDOptPtr sd_ctx_params = base_ctx.to_context_opt();
+    SDCtxPtr sd_ctx(create_sd_context(sd_ctx_params));
+    if (sd_ctx == nullptr) {
+        LOG_ERROR("sd_ctx_create failed");
+        return 1;
+    }
+    LOG_INFO("[multi] context ready in %.2fs; %zu image jobs%s", secs(load_start), lines.size(), phases ? " (phase batching)" : "");
+    // SD_MULTI_STOP_FILE: when that file exists, stop before the next job (a standby worker steps aside for another
+    // job after the image in progress); the jobs not run are reported, the exit code is 3.
+    const char* stop_file = std::getenv("SD_MULTI_STOP_FILE");
+    auto stop_now         = [&] { return stop_file != nullptr && fs::exists(stop_file); };
+
+    // parse a job line and load its inputs; nullptr (logged) when it cannot run
+    auto prepare = [&](size_t i) -> std::unique_ptr<Job> {
+        auto job = std::make_unique<Job>();
+        std::vector<const char*> job_argv;
+        for (const auto& a : lines[i]) {
+            job_argv.push_back(a.c_str());
+        }
+        std::vector<ArgOptions> options = {job->cli.get_options(), job->ctx.get_options(), job->gen.get_options()};
+        if (!parse_options(static_cast<int>(job_argv.size()), job_argv.data(), options) || !job->cli.resolve_and_validate() ||
+            !job->ctx.resolve_and_validate(job->cli.mode) ||
+            !job->gen.resolve_and_validate(job->cli.mode, job->ctx.lora_model_dir, job->ctx.hires_upscalers_dir)) {
+            LOG_ERROR("[multi] job %zu: invalid arguments", i + 1);
+            return nullptr;
+        }
+        SDGenerationParams& gen = job->gen;
+        bool ok                 = true;
+        auto load               = [&](const std::string& path, SDImageOwner& image, int channels) {
+            if (!load_sd_image_from_file(image.put(), path.c_str(), 0, 0, channels)) {
+                LOG_ERROR("[multi] job %zu: load image from '%s' failed", i + 1, path.c_str());
+                ok = false;
+                return;
+            }
+            gen.set_width_and_height_if_unset(image.get().width, image.get().height);
+        };
+        if (!gen.init_image_path.empty()) {
+            load(gen.init_image_path, gen.init_image, 0);
+        }
+        gen.ref_images.clear();
+        for (const auto& path : gen.ref_image_paths) {
+            SDImageOwner ref({0, 0, 0, nullptr});
+            load(path, ref, 0);
+            gen.ref_images.push_back(std::move(ref));
+        }
+        if (ok && !gen.mask_image_path.empty() && !load_sd_image_from_file(gen.mask_image.put(), gen.mask_image_path.c_str(), 0, 0, 1)) {
+            LOG_ERROR("[multi] job %zu: load mask '%s' failed", i + 1, gen.mask_image_path.c_str());
+            ok = false;
+        }
+        return ok ? std::move(job) : nullptr;
+    };
+
+    std::vector<std::unique_ptr<Job>> jobs(lines.size());
+    size_t stopped_at = lines.size();
+    const auto t0     = clock::now();
+    if (phases) {
+        // pass 1: conditioning of every job, the text encoder staged on the card once for all of them
+        // (SD_MULTI_TE_KEEP=0: staged and released per job as before)
+        const char* tk     = std::getenv("SD_MULTI_TE_KEEP");
+        const bool te_keep = tk == nullptr || std::string(tk) != "0";
+        sd_set_condition_only(sd_ctx.get(), true);
+        sd_set_retain_staged_weights(sd_ctx.get(), te_keep);
+        for (size_t i = 0; i < lines.size(); ++i) {  // never stopped: short, and pass 2 needs it to make anything
+            const auto js = clock::now();
+            jobs[i]       = prepare(i);
+            if (jobs[i] != nullptr) {
+                sd_result_t* generated = nullptr;
+                generate_sd_image(sd_ctx.get(), jobs[i]->gen.to_image_opt(), &generated);
+                sd_result_free(generated);
+            }
+            LOG_INFO("[multi] job %zu/%zu conditioned in %.2fs", i + 1, lines.size(), secs(js));
+        }
+        sd_set_condition_only(sd_ctx.get(), false);
+        sd_set_retain_staged_weights(sd_ctx.get(), false);
+        LOG_INFO("[multi] conditioning pass: %.2fs", secs(t0));
+        if (std::getenv("SD_XPU_H3_KEEP") == nullptr) {
+            setenv("SD_XPU_H3_KEEP", "1", 1);  // keep the blocks between the images of pass 2
+        }
+    }
+    int saved = 0;
+    for (size_t i = 0; i < lines.size() && stopped_at == lines.size(); ++i) {
+        if (saved > 0 && stop_now()) {  // at least one image a turn, so a worker that loaded the models makes progress
+            LOG_INFO("[multi] %s exists: stopping before job %zu/%zu", stop_file, i + 1, lines.size());
+            stopped_at = i;
+            break;
+        }
+        const auto job_start = clock::now();
+        std::unique_ptr<Job> job = phases ? std::move(jobs[i]) : prepare(i);
+        const std::string out    = job ? job->cli.output_path : std::string("?");
+        bool ok                  = job != nullptr;
+        if (ok) {
+            SDImageVec results;
+            sd_result_t* generated = nullptr;
+            generate_sd_image(sd_ctx.get(), job->gen.to_image_opt(), &generated);
+            results.adopt(generated, job->ctx.lora_model_dir);
+            const int n = results.count();
+            ok          = results && save_results(job->cli, job->ctx, job->gen, results, n, nullptr, "");
+        }
+        job.reset();
+        if (ok) {
+            ++saved;
+            LOG_INFO("[multi] job %zu/%zu saved %s in %.2fs", i + 1, lines.size(), out.c_str(), secs(job_start));
+        } else {
+            LOG_ERROR("[multi] job %zu/%zu (%s) failed after %.2fs", i + 1, lines.size(), out.c_str(), secs(job_start));
+        }
+    }
+    sd_clear_phase_caches(sd_ctx.get());
+    LOG_INFO("[multi] %d/%zu jobs saved in %.2fs (plus %.2fs context load)", saved, stopped_at, secs(t0),
+             std::chrono::duration<double>(t0 - load_start).count());
+    if (stopped_at < lines.size()) {
+        return saved == static_cast<int>(stopped_at) ? 3 : 1;
+    }
+    return saved == static_cast<int>(lines.size()) ? 0 : 1;
+}
