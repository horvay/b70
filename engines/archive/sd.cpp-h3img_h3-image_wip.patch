+void sd_set_condition_only(sd_ctx_t* ctx, bool on) {
+    if (ctx == nullptr || ctx->sd == nullptr) {
+        return;
+    }
+    std::lock_guard<std::recursive_mutex> lock(ctx->sd->execution_mutex);
+    ctx->sd->condition_only = on;
+}
+
+void sd_set_retain_staged_weights(sd_ctx_t* ctx, bool on) {
+    if (ctx == nullptr || ctx->sd == nullptr || ctx->sd->model_manager == nullptr) {
+        return;
+    }
+    std::lock_guard<std::recursive_mutex> lock(ctx->sd->execution_mutex);
+    ctx->sd->model_manager->set_retain_staged(on);
+}
+
+void sd_clear_phase_caches(sd_ctx_t* ctx) {
+    if (ctx == nullptr || ctx->sd == nullptr) {
+        return;
+    }
+    std::lock_guard<std::recursive_mutex> lock(ctx->sd->execution_mutex);
+    ctx->sd->ref_latent_cache.clear();
+}
