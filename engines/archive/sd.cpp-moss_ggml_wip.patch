+// GGML_SYCL_CONV2D_NAIVE=1 forces the generic path.
+static bool ggml_sycl_conv_2d_dnnl(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    static const bool naive = getenv("GGML_SYCL_CONV2D_NAIVE") != nullptr;
