+// XPU entry points (raw pointers are USM host addresses; kernels on the current torch XPU stream).
+// GPU -> host words: plain stores can sit in the GPU L3 between kernels of one in-order queue (no flush without a
+// host-visible event), which hung the back-to-back publish -> wait pair (host never saw req_seq). Upstream used
+// system-scope atomic RMWs, but on B70 an atomic access that page-faults on host USM cannot be resolved (xe only
+// services atomic faults by migrating to VRAM: "Fault response: Unsuccessful -EINVAL", engine CAT error), and under
+// RAM pressure the xe shrinker unbinds host buffers, so the first publish after that killed the context. ESIMD LSC
+// stores with L1+L3 uncached hints write through to host memory as ordinary (fault-resolvable) writes.
+template <typename T>
+struct NvmePubK {
+    const T* ids; int64_t* req; int n;
+    void operator()(sycl::nd_item<1> item) const SYCL_ESIMD_KERNEL {
+        int base = (int) item.get_global_id(0) * 16;
+        esn::simd_mask<16> m = esn::simd<int32_t, 16>(base, 1) < n;
+        esn::simd<uint32_t, 16> offi(0, sizeof(T));
+        esn::simd<T, 16> v = xe::lsc_gather<T, 1, xe::lsc_data_size::default_size, xe::cache_hint::none,
+                                            xe::cache_hint::none, 16>(ids + base, offi, m);
+        esn::simd<int64_t, 16> w = v;
+        esn::simd<uint32_t, 16> off(0, 8);
+        xe::lsc_scatter<int64_t, 1, xe::lsc_data_size::default_size, xe::cache_hint::uncached, xe::cache_hint::uncached,
+                        16>(req + base, off, w, m);
+        esn::fence<esn::memory_kind::global, esn::fence_flush_op::none, esn::fence_scope::system>();
+    }
+};
+struct NvmeSeqK {
+    uint32_t* ctrl; uint32_t* ds; uint32_t n;
+    void operator()(sycl::nd_item<1>) const SYCL_ESIMD_KERNEL {
+        esn::simd<uint32_t, 1> z(0);
+        uint32_t s = xe::lsc_gather<uint32_t, 1, xe::lsc_data_size::default_size, xe::cache_hint::uncached,
+                                    xe::cache_hint::uncached>(ds, z)[0] + 1;
+        xe::lsc_scatter<uint32_t, 1, xe::lsc_data_size::default_size, xe::cache_hint::uncached, xe::cache_hint::uncached>(
+            ds, z, esn::simd<uint32_t, 1>(s));
+        xe::lsc_scatter<uint32_t, 1, xe::lsc_data_size::default_size, xe::cache_hint::uncached, xe::cache_hint::uncached>(
+            ctrl + C_N, z, esn::simd<uint32_t, 1>(n));
+        esn::fence<esn::memory_kind::global, esn::fence_flush_op::none, esn::fence_scope::system>();
+        xe::lsc_scatter<uint32_t, 1, xe::lsc_data_size::default_size, xe::cache_hint::uncached, xe::cache_hint::uncached>(
+            ctrl + C_REQ, z, esn::simd<uint32_t, 1>(s));
+        esn::fence<esn::memory_kind::global, esn::fence_flush_op::none, esn::fence_scope::system>();
+    }
+};
+
+void nvme_publish(const at::Tensor& ids, int64_t req_dev, int64_t ctrl_dev, at::Tensor& dseq)
+{
+    TORCH_CHECK(ids.is_xpu() && ids.is_contiguous(), "nvme_publish: ids");
+    TORCH_CHECK(dseq.is_xpu() && dseq.scalar_type() == at::kInt, "nvme_publish: dseq");
+    int n = (int) ids.numel();
+    auto& q = c10::xpu::getCurrentXPUStream(ids.device().index()).queue();
+    int64_t* req = (int64_t*) req_dev;
+    if (n > 0)
+    {
+        size_t g = (((size_t) n + 15) / 16 + 15) / 16 * 16;
+        if (ids.scalar_type() == at::kLong)
+            q.parallel_for(sycl::nd_range<1>(g, 16), NvmePubK<int64_t>{ids.data_ptr<int64_t>(), req, n});
+        else if (ids.scalar_type() == at::kInt)
+            q.parallel_for(sycl::nd_range<1>(g, 16), NvmePubK<int32_t>{ids.data_ptr<int32_t>(), req, n});
+        else TORCH_CHECK(false, "nvme_publish: ids int32/int64");
+    }
+    q.parallel_for(sycl::nd_range<1>(1, 1), NvmeSeqK{(uint32_t*) ctrl_dev, (uint32_t*) dseq.data_ptr<int>(), (uint32_t) n});
+}
