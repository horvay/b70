+"""
+B70 spike: every (bit width, shape) of the checkpoint's dense EXL3 linears through torch.ops.exl3xpu_C.linear at several
+row counts, against the fp32 reference (trellis_core.reference.weight_orig). Lists launch failures (e.g.
+UR_RESULT_ERROR_OUT_OF_RESOURCES) and accuracy per case. One real tensor per (K, k, n); shared-expert gate+up also fused.
+
+  python3 tests/test_dense_bits.py --model /models/<ckpt> [--m 1,4,8,16,24,64,129,512]
+"""
+import argparse, json, os, re, sys
+import torch
+from safetensors import safe_open
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "..", "core", "src"))
+sys.path.insert(0, os.path.join(HERE, ".."))
+from trellis_core import reference as ref
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--model", required=True)
+ap.add_argument("--m", default="1,4,8,16,24,64,129,512")
+ap.add_argument("--only-k", default="")
+args = ap.parse_args()
+torch.ops.load_library(os.environ["EXL3_LIB"])
+C = torch.ops.exl3xpu_C
+dev = torch.device("xpu:0")
+idx = json.load(open(f"{args.model}/model.safetensors.index.json"))["weight_map"]
+handles = {}
+
+
+def get(name):
+    fn = idx[name]
+    if fn not in handles:
+        handles[fn] = safe_open(f"{args.model}/{fn}", "pt", device="cpu")
+    return handles[fn].get_tensor(name)
+
+
+# one representative per (K, k, n), skipping routed experts, vision and the MTP head
+seen, cases = set(), []
+for name in sorted(idx):
+    if not name.endswith(".trellis") or ".experts." in name or "visual" in name or "mtp" in name:
+        continue
+    base = name[:-len(".trellis")]
+    fn = idx[name]
+    if fn not in handles:
+        handles[fn] = safe_open(f"{args.model}/{fn}", "pt", device="cpu")
+    sh = handles[fn].get_slice(name).get_shape()
+    K = sh[2] // 16
+    key = (K, sh[0] * 16, sh[1] * 16)
+    if args.only_k and str(K) not in args.only_k.split(","):
+        continue
+    if key not in seen:
+        seen.add(key)
+        cases.append(([base], key))
+# fused shared-expert gate+up per K (the call that failed in serving)
+for K_want in (3, 4, 5):
+    for name in sorted(idx):
+        m = re.match(r"(.*\.mlp\.shared_expert)\.gate_proj\.trellis$", name)
+        if m and handles.setdefault(idx[name], safe_open(f"{args.model}/{idx[name]}", "pt", device="cpu")).get_slice(name).get_shape()[2] // 16 == K_want:
+            cases.append(([m.group(1) + ".gate_proj", m.group(1) + ".up_proj"], ("fused", K_want)))
+            break
+
+print(f"{len(cases)} cases", flush=True)
+Ms = [int(v) for v in args.m.split(",")]
+fails = 0
+for bases, key in cases:
+    t = [{s: get(b + "." + s) for s in ("trellis", "suh", "svh")} for b in bases]
+    K = t[0]["trellis"].shape[2] // 16
+    tr = torch.cat([x["trellis"] for x in t], 1).contiguous().to(dev) if len(t) > 1 else t[0]["trellis"].contiguous().to(dev)
+    suh = torch.stack([x["suh"].half() for x in t]).contiguous().to(dev)
+    svh = torch.cat([x["svh"].half() for x in t]).contiguous().to(dev)
+    bounds = [0]
+    for x in t:
+        bounds.append(bounds[-1] + x["trellis"].shape[1] * 16)
+    sonb = torch.empty(bounds[-1] // 128, dtype=torch.int32)
+    for g in range(len(bounds) - 1):
+        sonb[bounds[g] // 128: bounds[g + 1] // 128] = g
+    sonb = sonb.to(dev)
+    W = torch.cat([ref.weight_orig(x["trellis"].to(dev), x["suh"].to(dev), x["svh"].to(dev), K, 2) for x in t], 1)
+    kdim = W.shape[0]
+    for M in Ms:
+        x = (torch.randn((M, kdim), generator=torch.Generator().manual_seed(M)) * 0.5).to(torch.bfloat16).to(dev)
+        try:
+            y = C.linear(x, tr, suh, svh, sonb, bounds, K, 2, 128, 16384)
+            torch.xpu.synchronize()
+            r = x.float() @ W
+            rms = ((y.float() - r).pow(2).mean().sqrt() / r.pow(2).mean().sqrt()).item()
+            status = "ok" if rms < 0.02 else "WRONG"
+            fails += status != "ok"
+            print(f"{str(key):22s} {'+'.join(b.split('.')[-1] for b in bases):18s} M={M:4d} {status} rms_rel={rms:.4f}", flush=True)
+        except Exception as e:
+            fails += 1
+            print(f"{str(key):22s} {'+'.join(b.split('.')[-1] for b in bases):18s} M={M:4d} FAIL {str(e).splitlines()[0][:110]}", flush=True)
+            torch.xpu.synchronize()
+print(f"{len(cases)} shapes x {len(Ms)} row counts, {fails} failures", flush=True)
