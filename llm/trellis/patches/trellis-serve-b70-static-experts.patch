--- /dev/null
+++ w/xpu/tests/probe_kernel_load.py
@@ -0,0 +1,63 @@
+"""B70 spike: does loading many JIT kernel variants in one process make a later kernel launch fail with
+UR_RESULT_ERROR_OUT_OF_RESOURCES? Runs dense EXL3 linears (K=3/4/5) and grouped MoE (K=3/4) over many row counts on
+random data (values irrelevant), then the n-gram NVMe lookup that failed in serving."""
+import os, sys, time
+import torch
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+t0 = time.time()
+def say(m): print(f"[{time.time() - t0:6.1f}s] {m}", flush=True)
+dev = torch.device("xpu", 0)
+torch.ops.load_library(os.environ["EXL3_LIB"])
+C = torch.ops.exl3xpu_C
+from exl3xpu.moe_offload import ops
+X = ops()
+n_launch = 0
+
+
+def dense(K, k, n, M):
+    global n_launch
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * K), dtype=torch.int16, device=dev)
+    suh = (torch.rand((1, k), device=dev) + 0.5).half()
+    svh = (torch.rand(n, device=dev) * 0.01).half()
+    sonb = torch.zeros(n // 128, dtype=torch.int32, device=dev)
+    x = torch.randn((M, k), device=dev).to(torch.bfloat16)
+    C.linear(x, tr, suh, svh, sonb, [0, n], K, 2, 128, 16384)
+    torch.xpu.synchronize()
+    n_launch += 1
+
+
+def moe(K, M):
+    global n_launch
+    H, I, E = 2560, 640, 512
+    blob = int(X.blob_bytes(H, I, K))
+    arena = torch.randint(0, 255, (E, blob), dtype=torch.uint8, device=dev)
+    ptrs = (arena.data_ptr() + torch.arange(E, dtype=torch.int64) * blob).to(dev)
+    x = torch.randn((M, H), device=dev).to(torch.bfloat16)
+    w, ids = torch.topk(torch.softmax(torch.randn((M, E), device=dev), -1), 10, dim=-1)
+    X.moe_forward(x, ids.to(torch.int32).contiguous(), (w / w.sum(-1, keepdim=True)).float().contiguous(), ptrs, I, K, E)
+    torch.xpu.synchronize()
+    n_launch += 1
+
+
+stage = "start"
+try:
+    for K in (3, 4, 5):
+        for (k, n) in ((2560, 1280), (640, 2560)):
+            for M in (1, 4, 23, 129):
+                stage = f"dense K={K} {k}x{n} M={M}"
+                dense(K, k, n, M)
+        say(f"dense K={K} done ({n_launch} calls)")
+    for K in (3, 4):
+        for M in (1, 4, 23, 600):
+            stage = f"moe K={K} M={M}"
+            moe(K, M)
+        say(f"moe K={K} done ({n_launch} calls)")
+    stage = "ngram"
+    from exl3xpu.ngram_nvme import Exl3NgramNvmeTable
+    nv = Exl3NgramNvmeTable(os.environ["MODEL"], ram_gb=4.0, device=dev)
+    ids = torch.randint(0, nv.num_rows, (23, 16), dtype=torch.int64).to(dev)
+    out = nv.gather(ids); torch.xpu.synchronize()
+    say(f"n-gram gather after {n_launch} kernel-variant calls: ok, finite={bool(torch.isfinite(out.float()).all())}")
+except Exception as e:
+    say(f"FAILED at {stage} after {n_launch} calls: {str(e).splitlines()[0]}")
+    sys.exit(1)
