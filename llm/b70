def serve_glm(a, model, store):
    if not glm_store_ready(store):
        fail(f"the GLM expert store is not packed in {store}; run `b70 prepare {model}` first")
    ctx = min(a.ctx or 49152, 65536)
    # GLM_MODE (environment, else ~/.config/b70/serve.env): quality (default) or fast.
    #   quality: synced router with a residency bonus: decode picks a cached expert over an NVMe-only one whose router
    #     score is < 0.1 higher. ~10-11 tok/s; KL vs the exact model 0.010-0.012 (exact 0.003), top-1 agreement 93-96%.
    #   fast: no-sync router: only resident experts (VRAM, then RAM at a 0.2 margin), no host sync per layer. ~18-20
    #     tok/s, but 20-29% of picks are forced substitutes: KL 0.13-0.25, top-1 agreement 77-83% (2026-10-30).
    # GLM_XPU_* keys in serve.env apply too; the environment wins over the file, both over the mode's defaults.
    local = local_defaults("serve")
    mode = os.environ.get("GLM_MODE", local.get("GLM_MODE", "quality"))
    if mode == "fast":
        env = {"GLM_XPU_NOSYNC": "1", "GLM_XPU_RAM_MARGIN": "0.2", "GLM_XPU_RES_BONUS": "0"}
    elif mode == "quality":
        env = {"GLM_XPU_RAM_MARGIN": "0.2", "GLM_XPU_RES_BONUS": "0.1", "GLM_XPU_MISS_PF": "0"}
    else:
        fail(f"GLM_MODE={mode!r}: quality or fast")
    env.update({k: v for k, v in local.items() if k.startswith(("GLM_XPU_", "GLM_SERVE_"))})
    env.update({k: v for k, v in os.environ.items() if k.startswith(("GLM_XPU_", "GLM_SERVE_"))})
    # GLM_ENGINE (environment, else serve.env): python (default) = glm/xpu/serve.py in the image; cpp = the C++ engine
    # (engines/glm.cpp, its build/glm_server: no PyTorch, run on the host, same API, arguments and quality mode)
    engine = os.environ.get("GLM_ENGINE", local.get("GLM_ENGINE", "python"))
    if engine == "cpp":
        return serve_glm_cpp(a, model, store, mode, env, ctx)
    if engine != "python":
        fail(f"GLM_ENGINE={engine!r}: python or cpp")
    cmd = ["python3", "/w/xpu/serve.py", "--host", "127.0.0.1", "--port", str(a.inner_port), "--cache", str(ctx),
           "--served-name", a.name or "glm-5.3-flash", "--store", "/nvx/glm53_flash_exl3_experts_blob.bin"]
    # lora/ and lora-*/ subfolders (e.g. lora-ablit/) are PEFT adapters, applied at load in name order
    lora = sorted(n for n in os.listdir(model) if (n == "lora" or n.startswith("lora-"))
                  and os.path.isfile(os.path.join(model, n, "adapter_config.json")))
    # The server peaks at its RAM tier plus ~12 GB (the prompt read-ahead ring of 384 pinned records, the NVMe bounce
    # ring, ~6 GB of process memory). A fixed 22 GB tier reached 33 GB on a 21.6k-token prompt with 37 GB free and
    # tripped the guard's 4 GB floor (2026-10-28), so without --ram-gb the tier is what is free now less 12 GB, the
    # floor and 3 GB spare: 22 GB on a quiet desktop, less beside a busy browser.
    ram = a.ram_gb or max(12, min(22, int(avail_gb() - 19)))
    cmd += ["--ram-gb", str(ram)]
    if a.chat_template:
        cmd += ["--chat-template", "/opt/chat_template.jinja"]
    if lora:
        cmd += ["--lora", ",".join(f"/models/{n}" for n in lora)]   # GLM_XPU_LORA_SCALE scales them, 0 turns them off
    # host RAM to start: the tier, ~10 GB more, and the guard's 4 GB floor (a fixed 40 kept 22 GB servers waiting)
    return sandbox("glm", cmd, gpu=True, model=model, store=store, env=env, template=a.chat_template), int(ram + 14), \
        {"model": a.name or "glm-5.3-flash", "messages": [{"role": "user", "content": "Hello."}], "max_tokens": 1}


def serve_glm_cpp(a, model, store, mode, env, ctx):
    """GLM-5.3-Flash on engines/glm.cpp's glm_server, outside the image (its oneAPI runtime is linked by rpath).
    Quality mode only (the C++ engine has no no-sync router); --chat-template is the client's prefill hook, built in."""
    if mode != "quality":
        fail("GLM_ENGINE=cpp serves GLM_MODE=quality only")
    exe = os.path.join(os.path.dirname(REPO), "engines", "glm.cpp", "build", "glm_server")
