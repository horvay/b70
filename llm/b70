def remove_tree(path):
    """rmtree that also clears overlayfs' mode-000 work directories."""
    for root, dirs, _ in os.walk(path):
        for d in dirs:
            try:
                os.chmod(os.path.join(root, d), 0o700)
            except OSError:
                pass
    shutil.rmtree(path, ignore_errors=True)


def setup_sglang():
    fetch_trellis()
    if running_server():
        fail("a b70 server runs from the image setup would change; `b70 stop` first")
    say("sglang: building trellis-serve's kernels and installing the plugin (a few minutes)")
    run_in("sglang", ["bash", "-euo", "pipefail", "-c", SGLANG_BUILD], write_root=True)
    remove_tree(os.path.join(STATE, "overlay"))            # the persistent overlay of earlier setups


def cmd_setup(a):
    fams = SETUPS if a.family == "all" else [a.family]
    setup_image()
    for fam in fams:
        if setup_done(fam) and not a.force:
            say(f"{fam}: already set up")
            continue
        {"glm": setup_glm, "sglang": setup_sglang, "dsv41": setup_dsv41}[fam]()
        with open(setup_marker(fam), "w") as f:
            json.dump(setup_wanted(fam), f)
        say(f"{fam}: setup done")


# ------------------------------------------------------------------------------------------------- info / prepare

def model_info(model_dir, store=None):
    fam, cfg = read_model(model_dir)
    info = {"model": os.path.abspath(model_dir), "family": fam, "model_type": cfg.get("model_type")}
    if fam:
        store = store or default_store(fam)
        info.update(setup=setup_done(fam), store=store, prepared=store_ready(fam, store),
                    parallel_max=1 if fam in ("glm", "dsv41") else 8,
                    context_max=65536 if fam in ("glm", "dsv41") else 217088)
    return info


def cmd_info(a):
    print(json.dumps(model_info(a.model, a.store), indent=1))


def make_store_dir(store):
    if not os.path.isdir(store):
        os.makedirs(store, exist_ok=True)
        # btrfs: no copy-on-write or checksums, so O_DIRECT reads work
        subprocess.run(["chattr", "+C", store], capture_output=True)


def cmd_prepare(a):
    prepare(a.model, a.store, a.force)


def prepare(model, store, force=False):
    a = argparse.Namespace(model=model, store=store, force=force)
    fam, _ = read_model(a.model)
    if not fam:
        fail(f"{a.model} is not a model b70 serves")
    if not setup_done(fam):
        fail(f"{fam} is not set up; run `b70 setup {fam}` first")
    store = os.path.abspath(a.store or default_store(fam))
    if fam == "dsv41":
        if dsv41_store_ready(store) and not a.force:
            say(f"dsv41: expert store already packed in {store}")
            return
        make_store_dir(store)
        say(f"dsv41: packing the routed experts into {store} (~105 GB, reads the whole model), then the drafter's")
        run_in("dsv41", ["python3", "-u", "-m", "dsv_xpu.pack_store", "/models", "/nvx"], model=os.path.abspath(a.model),
               store=store)
        run_in("dsv41", ["python3", "-u", "-c", "from dsv_xpu.pack_store import append_mtp; append_mtp('/models', '/nvx')"],
               model=os.path.abspath(a.model), store=store)
        return
    if fam != "glm":
        say(f"{fam} needs no prepare step" + (": the first load writes its NVMe store" if fam == "flashnext" else ""))
        return
    if glm_store_ready(store) and not a.force:
        say(f"glm: expert store already packed in {store}")
        return
    make_store_dir(store)
    say(f"glm: packing the routed experts into {store} (~95 GB, reads the whole model)")
    run_in("glm", ["python3", "-u", "/w/xpu/pack_store.py", "pack"], model=os.path.abspath(a.model), store=store)


# ------------------------------------------------------------------------------------------------ the b70q queue

class _UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path, timeout):
        super().__init__("b70q", timeout=timeout)
        self.sock_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.sock_path)


def b70q_socket():
    return os.environ.get("B70Q_SOCKET") or os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}",
                                                         "b70q.sock")


def b70q(method, path, body=None, timeout=20):
    """The b70q daemon's HTTP API over its unix socket; raises OSError when the daemon is not there."""
    c = _UnixHTTP(b70q_socket(), timeout)
    try:
        c.request(method, path, body=None if body is None else json.dumps(body),
                  headers={"content-type": "application/json"})
        r = c.getresponse()
        data = r.read()
        if r.status >= 400:
            raise OSError(f"b70q {method} {path}: HTTP {r.status} {data[:200]!r}")
        return json.loads(data or b"{}")
    except (http.client.HTTPException, ValueError) as e:
        raise OSError(f"b70q {method} {path}: {e}") from e
    finally:
        c.close()


def parse_duration(text):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([smhd]?)", text.strip())
    if not m:
        fail(f"bad duration {text} (use 90, 90s, 15m, 4h)")
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def queue_turn(owner, note, opts):
    """Waits in the b70q queue until this process holds the B70. Returns the ticket id, or None when the card is already
    ours (inside a queue job: B70Q_TICKET) or no queue daemon runs. While waiting it prints its place in line every
    minute (and when it changes). SIGTERM / SIGINT while waiting leaves the line and exits."""
    if os.environ.get("B70Q_TICKET"):
        return None
    try:
        t = b70q("POST", "/api/tickets", {"owner": owner, "kind": "run", "argv": sys.argv, "cwd": os.getcwd(),
                                          "client_pid": os.getpid(), "note": note, "opts": opts})
    except OSError:
        say("no b70q queue daemon; using the B70 without it")
        return None
    tid = t["id"]
    if t.get("nested"):
        return None

    def leave(signum, _frame):
        try:
            b70q("POST", f"/api/tickets/{tid}/cancel", timeout=5)
        except OSError:
            pass
        say(f"left the B70 queue (#{tid})")
        sys.exit(128 + signum)
    old = {sg: signal.signal(sg, leave) for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    last, last_at, down_since = None, 0.0, None
    try:
        while True:
            try:
                w = b70q("GET", f"/api/tickets/{tid}/wait?until=granted&timeout=8", timeout=30)
                down_since = None
            except OSError as e:
                down_since = down_since or time.time()
                if time.time() - down_since > 300:
                    say(f"lost the b70q daemon for 5 minutes ({e}); using the B70 without it")
                    return None
                time.sleep(2)
                continue
            tk = w["ticket"]
            if tk["state"] == "granted":
                say(f"the B70 is ours (b70q #{tid} {owner})")
                os.environ["B70Q_TICKET"] = str(tid)
                return tid
            if tk["state"] != "waiting":
                fail(f"b70q #{tid} {tk['state']} while waiting: {tk.get('end_reason')}", 75)
            msg = queue_wait_text(tid, w)
            if msg != last or time.time() - last_at >= 60:
                say(msg)
                last, last_at = msg, time.time()
    finally:
        for sg, h in old.items():
            signal.signal(sg, h)


def queue_wait_text(tid, w):
    """"waiting for the B70: 2 in line, ~6 min (dsv41-sweep has it)", from the ticket's wait reply and /api/state."""
    eta = None
    try:
        st = b70q("GET", "/api/state", timeout=5)
        mine = next((q for q in st.get("queue", []) if q.get("id") == tid), None)
        if mine and mine.get("eta_start"):
            eta = max(0, (mine["eta_start"] - st["t"]) / 60000)
    except OSError:
        pass
    status = (w.get("status") or {}).get("text") or "busy"
    where = f"{w.get('position', '?')} in line"
    return f"waiting for the B70: {where}{f', ~{eta:.0f} min' if eta is not None else ''} ({status})"


def queue_done(tid, rc, reason=None):
    if tid is None:
        return
    for _ in range(10):
        try:
            b70q("POST", f"/api/tickets/{tid}/done", {"exit_code": rc, **({"reason": reason} if reason else {})}, timeout=5)
            return
        except OSError:
            time.sleep(1)


# ----------------------------------------------------------------------------------------------------- the guard

def b70_pci():
    """PCI address of the first GPU on the xe driver (the B70)."""
    for r in sorted(os.listdir("/sys/class/drm")):
        if not r.startswith("renderD"):
            continue
        dev = os.path.realpath(f"/sys/class/drm/{r}/device")
        if os.path.basename(os.path.realpath(os.path.join(dev, "driver"))) == "xe":
            return os.path.basename(dev), f"/dev/dri/{r}"
    return None, None


def avail_gb():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) / 1048576
    return 0.0


def psi_full():
    try:
        with open("/proc/pressure/memory") as f:
            for line in f:
                if line.startswith("full"):
                    return float(line.split()[1].split("=")[1])
    except OSError:
        pass
    return 0.0


SHELLS = {"bash", "sh", "zsh", "dash", "fish", "grep", "timeout", "tail"}


def other_jobs(pattern, render, skip):
    """Processes whose command line matches `pattern` that have the B70's render node open (a Steam game)."""
    if not pattern or not render:
        return []
    rx = re.compile(pattern)
    found = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) in skip:
            continue
        try:
            args = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
            comm = open(f"/proc/{pid}/comm").read().strip()
            if comm in SHELLS or not rx.search(args):
                continue
            for fd in os.listdir(f"/proc/{pid}/fd"):
                if os.readlink(f"/proc/{pid}/fd/{fd}") == render:
                    found.append(f"{pid} {args[:100]}")
                    break
        except OSError:
            continue
    return found


FAULT = re.compile(r"Fault|CAT error|[Hh]ang|[Rr]eset|wedged|Timedout")


class Guard:
    """Runs the server in its own process group and stops the group on an xe fault, low RAM, memory pressure, or
    SIGTERM/SIGINT to this process. Who else may use the B70 is the b70q queue's business, not the guard's."""

    def __init__(self, ram_start_gb):
        self.ram_floor = float(os.environ.get("B70_RAM_FLOOR_GB", "4"))
        self.psi_max = float(os.environ.get("B70_PSI_MAX", "40"))
        self.psi_secs = float(os.environ.get("B70_PSI_SECS", "20"))     # a long prompt spikes it for a few seconds
        self.ram_start = float(os.environ.get("B70_RAM_START_GB", ram_start_gb))
        self.games = os.environ.get("B70_GAMES", r"steamapps[/\\]common[/\\]")
        self.pci, self.render = b70_pci()
        self.proc = None
        self.reason = None
        self.expected = False       # stopped on purpose (asked to, or stepping aside for another job): exit 0
        self.journal = None
        self.lock = threading.Lock()

    def check_start(self):
        problem = self.problem()
        if problem:
            fail(problem, 98 if self.pci else 1)

    def problem(self):
        """Why the server must not start now, or None."""
        if not self.pci:
            return "no GPU on the xe driver found (the B70 needs the xe kernel driver)"
        a = avail_gb()
        if a < self.ram_start:
            return f"GUARD: not starting, only {a:.0f} GB RAM available (need {self.ram_start:.0f})"
        # a Steam game under Proton opens every GPU, the B70 too, even when it renders on another card; model loads
        # beside one failed binding B70 memory (UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY / DEVICE_LOST, xe "VM worker
        # error: -16"). Only checked at the start: a server already running is left alone.
        o = other_jobs(self.games, self.render, {os.getpid()})
        if o:
            return f"GUARD: not starting, a game has the B70 open: {o[0]}"
        return None

    def stop(self, reason, expected=False):
        with self.lock:
            if self.reason or not self.proc or self.proc.poll() is not None:
                return
            self.reason, self.expected = reason, expected
        print(f"GUARD: {reason}, stopping the server", flush=True)
        if not expected:                    # who was using the memory, for the post-mortem
            top = subprocess.run(["ps", "-eo", "pid,rss,args", "--sort=-rss"], capture_output=True, text=True).stdout
            for line in top.splitlines()[1:9]:
                pid, rss, cmd = (line.split(None, 2) + ["", ""])[:3]
                print(f"GUARD   {pid:>8} {int(rss or 0) / 1048576:5.1f} GB  {cmd[:110]}", flush=True)
        try:
            os.killpg(self.proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        for _ in range(80):
            if self.proc.poll() is not None:
                return
            time.sleep(0.1)
        try:
            os.killpg(self.proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    def watch_kernel(self, t0):
        try:
            j = subprocess.Popen(["journalctl", "-k", "-f", "-n", "0", "--since", f"@{int(t0)}", "-o", "short-unix",
                                  "--no-pager"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return
        self.journal = j
        tag = f"xe {self.pci}"
        for line in j.stdout:
            try:
                if float(line.split()[0]) < t0:
                    continue
            except (ValueError, IndexError):
                pass
            if tag in line and FAULT.search(line):
                self.stop(f"B70 fault in the kernel log: {line.strip()[:200]}")
            if self.proc.poll() is not None:
                break
        j.kill()

    def watch_memory(self):
        high_since = None      # a prompt of 40K tokens or more reads 50 GB from the experts' NVMe tier and spikes the pressure
        while self.proc.poll() is None and not self.reason:
            a, p = avail_gb(), psi_full()
            high_since = (high_since or time.time()) if p > self.psi_max else None
            if a < self.ram_floor:
                self.stop(f"RAM low ({a:.1f} GB available, floor {self.ram_floor:.0f})")
            elif high_since and time.time() - high_since >= self.psi_secs:
                self.stop(f"memory pressure {p:.0f}% (full avg10, max {self.psi_max:.0f}) for {self.psi_secs:.0f} s, "
                          f"{a:.1f} GB RAM available")
            time.sleep(1)

    def run(self, args, ready=None, signals=True):
        t0 = time.time()

        def child():
            os.setsid()
            try:
                with open("/proc/self/oom_score_adj", "w") as f:
                    f.write("1000")       # the kernel OOM killer takes the server before anything of the user's
            except OSError:
                pass

        self.proc = subprocess.Popen(args, preexec_fn=child)
        if signals:
            for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(s, lambda *_: threading.Thread(target=self.stop, args=("asked to stop", True)).start())
        threading.Thread(target=self.watch_kernel, args=(t0,), daemon=True).start()
        threading.Thread(target=self.watch_memory, daemon=True).start()
        if ready:
            threading.Thread(target=ready, daemon=True).start()
        while True:
            try:
                rc = self.proc.wait()
                break
            except InterruptedError:
                continue
        if self.journal:
            self.journal.kill()
        if self.reason and not self.expected:
            print(f"GUARD tripped: {self.reason}", flush=True)
            return 99
        return 0 if self.expected else rc


# ------------------------------------------------------------------------------------------- warm-up and port gate

def free_port():
    import socket
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def relay(listen_port, target_port):
    """Forward every TCP connection on 127.0.0.1:listen_port to target_port, byte for byte (streams, keep-alive and a
    client hanging up, which cancels its request, all pass through)."""
    import asyncio

    async def pipe(reader, writer):
        try:
            while data := await reader.read(65536):
                writer.write(data)
                await writer.drain()
        except (ConnectionError, OSError):
            pass
        finally:
            try:
                writer.close()
            except (ConnectionError, OSError):
                pass

    async def handle(client_r, client_w):
        try:
            up_r, up_w = await asyncio.open_connection("127.0.0.1", target_port)
        except OSError:
            client_w.close()
            return
        await asyncio.gather(pipe(client_r, up_w), pipe(up_r, client_w))

    async def main():
        server = await asyncio.start_server(handle, "127.0.0.1", listen_port, reuse_address=True)
        async with server:
            await server.serve_forever()

    asyncio.run(main())


def open_when_warm(a, warm, alive):
    """Wait for the server on its inner port, send it `warm` (one real request: kernels compile, graphs and caches
    fill), then open the requested port. Until then the port is closed, so a client never meets a server that is up
    but still warming (SGLang answered /v1/models seconds late right after its start, and client discovery with a
    short timeout found no model)."""
    if wait_warm(a, warm, alive):
        threading.Thread(target=relay, args=(a.port, a.inner_port), daemon=True).start()
        say(f"ready on http://127.0.0.1:{a.port}/v1")


def wait_warm(a, warm, alive):
    """Wait for the server on its inner port and send it `warm`; False when it died first."""
    url = f"http://127.0.0.1:{a.inner_port}"
    while alive():
        try:
            urllib.request.urlopen(f"{url}/v1/models", timeout=5).read()
            break
        except (OSError, http.client.HTTPException):
            time.sleep(2)
    else:
        return False
    t0 = time.time()
    try:
        urllib.request.urlopen(urllib.request.Request(f"{url}/v1/chat/completions", json.dumps(warm).encode(),
                                                      {"Content-Type": "application/json"}), timeout=900).read()
        say(f"warm-up request done in {time.time() - t0:.0f} s")
    except (OSError, http.client.HTTPException) as e:
        say(f"warm-up request failed ({e}); opening the port anyway")
    return alive()


# ---------------------------------------------------------------------------------- standby: the B70's idle model

# `serve --standby` keeps the model on the B70 only while nothing else wants the card. The b70q queue loads it once the
# card has been free a while and asks it to step aside when another job waits and no request has run on it for a
# minute; the server reports both (busy, time since its last request) to /api/tickets/<id>/activity every few seconds.
# Its port stays open the whole time (after the first load): while the model is unloaded, discovery is answered from
# the last load, and a request waits for the model, putting the server in line for the card; a streamed one gets
# keep-alive chunks meanwhile (llama.cpp's prompt_progress when it asked for them, else SSE comments), so the client's
# first-token watchdog doesn't give up. After a reload no request was waiting for, the last request is read again (one
# token, answered to nobody), so the next one finds its prompt in the cache: a cold 17K-token prompt takes
# DeepSeek-V4.1 about 5 minutes.

HOP_HEADERS = {"connection", "keep-alive", "proxy-connection", "transfer-encoding", "content-length", "te", "upgrade"}
SSE_HEAD = b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n"


def local_defaults(name):
    """KEY=VALUE lines of ~/.config/b70/<name>.env: this machine's own defaults, kept out of the repo."""
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "b70", f"{name}.env")
    out = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip().strip("'\"")
    except OSError:
        pass
    return out


async def read_head(reader):
    """An HTTP/1.1 head: its first line and its headers."""
    lines = (await reader.readuntil(b"\r\n\r\n")).decode("latin-1").split("\r\n")
    return lines[0], [(k.strip(), v.strip()) for k, v in (ln.split(":", 1) for ln in lines[1:] if ":" in ln)]


async def dechunk(reader):
    """The payload of a chunked body, piece by piece."""
    while True:
        size = int((await reader.readuntil(b"\r\n")).split(b";")[0].strip() or b"0", 16)
        if not size:
            while await reader.readuntil(b"\r\n") != b"\r\n":      # trailers
                pass
            return
        yield await reader.readexactly(size)
        await reader.readexactly(2)


def http_answer(status, body, ctype="application/json"):
    return f"HTTP/1.1 {status}\r\nContent-Type: {ctype}\r\nContent-Length: {len(body)}\r\nConnection: close\r\n\r\n" \
        .encode("latin-1") + body


class Gate:
    """A standby server's port: sends each request to the model while it is loaded (one request per connection, so a
    request's end is its connection's), counts the requests in flight and when the last one ended, and holds requests
    while the model is unloaded. Its methods without `async` are for the other threads."""

    def __init__(self, port, name):
        self.port, self.name = port, name
        self.lock = threading.Lock()
        self.target = None          # the model's inner port while it is loaded and warm
        self.inflight = 0           # requests on their way to the model or back
        self.held = 0               # requests waiting for the model
        self.last_end = 0.0         # when the last request ended (0: none yet)
        self.failure = None         # why the waiting requests can't be served (the model can't load now)
        self.models = None          # the model's /v1/models answer, for discovery while it is unloaded
        self.last_work = None       # (path, body) of the last completion request, read again after a reload
        self.loop = self.changed = None

    def listen(self):
        if self.loop:
            return
        started, error = threading.Event(), []

        def run():
            loop = asyncio.new_event_loop()
            self.changed = asyncio.Event()
            try:
                loop.run_until_complete(asyncio.start_server(self.handle, "127.0.0.1", self.port, reuse_address=True,
                                                             limit=1 << 22))
            except OSError as e:
                error.append(e)
                started.set()
                return
            self.loop = loop
            started.set()
            loop.run_forever()
        threading.Thread(target=run, daemon=True).start()
        started.wait()
        if error:
            raise error[0]

    def _wake(self):
        def wake():
            self.changed.set()
            self.changed = asyncio.Event()
        if self.loop:
            self.loop.call_soon_threadsafe(wake)

    def open(self, target, models=None, touch=False):
        """The model is loaded and warm on `target`; `touch` starts its quiet time now (a first load)."""
        with self.lock:
            self.target, self.failure = target, None
            self.models = models or self.models
            if touch:
                self.last_end = time.time()
        self._wake()

    def close(self, force=False):
        """No more requests to the model. Refused (False) while one is in flight or waiting, unless forced."""
        with self.lock:
            if not force and (self.inflight or self.held):
                return False
            self.target = None
        return True

    def refuse_waiting(self, why):
        """The model can't load now: the waiting requests (and new ones, until clear()) are answered with `why`."""
        with self.lock:
            self.failure = why
        self._wake()

    def clear(self):
        with self.lock:
            self.failure = None

    def activity(self):
        """(in use, seconds since the last request ended) for the queue."""
        with self.lock:
            return bool(self.inflight or self.held), (time.time() - self.last_end if self.last_end else 1e9)

    # --- the port (the gate's event loop)

    async def handle(self, reader, writer):
        try:
            await self.serve(reader, writer)
        except (OSError, ValueError, IndexError, asyncio.IncompleteReadError, asyncio.LimitOverrunError):
            pass
        finally:
            writer.close()

    async def serve(self, reader, writer):
        line, headers = await read_head(reader)
        method, path = line.split(" ")[:2]
        h = {k.lower(): v for k, v in headers}
        if "chunked" in h.get("transfer-encoding", "").lower():
            body = b"".join([part async for part in dechunk(reader)])
        else:
            body = await reader.readexactly(int(h.get("content-length") or 0))
        if method != "POST":            # discovery and health: no work for the model, and not activity
            with self.lock:
                target = self.target
            if target is None:
                return await self.unloaded(writer, path)
            return await self.forward(reader, writer, line, headers, body, target)
        try:
            req = json.loads(body or b"{}")
        except ValueError:
            req = None
        req = req if isinstance(req, dict) else {}
        if path.split("?")[0].endswith("completions") and ("messages" in req or "prompt" in req):
            self.last_work = (path, body)
        stream = req.get("stream") is True
        target, sent = await self.wait_for_model(reader, writer, stream, stream and req.get("return_progress") is True)
        if target is None:
            return
        try:
            await self.forward(reader, writer, line, headers, body, target, sent)
        finally:
            with self.lock:
                self.inflight -= 1
                self.last_end = time.time()

    async def wait_for_model(self, reader, writer, stream, progress):
        """(the model's port, whether an event stream was started meanwhile) once the request may go to the model,
        counted in flight; (None, _) when the client hung up or the model can't load (answered)."""
        with self.lock:
            if self.target is not None:
                self.inflight += 1
                return self.target, False
            self.held += 1
        sent, held, t0 = False, True, time.time()
        gone = asyncio.ensure_future(reader.read(1))
        try:
            while True:
                with self.lock:
                    target, failure = self.target, self.failure
                    if target is not None:
                        self.held -= 1
                        self.inflight += 1
                        held = False
                if target is not None:
                    return target, sent
                if failure:
                    await self.refuse(writer, failure, sent)
                    return None, sent
                if stream:
                    if not sent:
                        writer.write(SSE_HEAD)
                        sent = True
                    writer.write(self.keepalive(progress, t0))
                    await writer.drain()
                changed = asyncio.ensure_future(self.changed.wait())
                done, _ = await asyncio.wait({changed, gone}, timeout=15, return_when=asyncio.FIRST_COMPLETED)
                changed.cancel()
                if gone in done:
                    if not gone.result():
                        return None, sent                       # the client hung up
                    gone = asyncio.get_running_loop().create_future()
        finally:
            gone.cancel()
            if held:
                with self.lock:
                    self.held -= 1

    def keepalive(self, progress, t0):
        if not progress:
            return b": waiting for the model (standby: loading, or waiting for the B70)\n\n"
        chunk = {"id": "chatcmpl-standby", "object": "chat.completion.chunk", "created": int(t0), "model": self.name,
                 "choices": [{"index": 0, "delta": {"role": "assistant", "content": None}, "finish_reason": None}],
                 # nothing read yet: the model is loading or waiting for the card
                 "prompt_progress": {"total": 0, "cache": 0, "processed": 0, "time_ms": round((time.time() - t0) * 1000)}}
        return b"data: " + json.dumps(chunk).encode() + b"\n\n"

    async def forward(self, reader, writer, line, headers, body, target, sent=False):
        """The request to the model on a connection of its own, and its answer back; after an event stream was started
        (`sent`), only the answer's payload, or its error as the last event."""
        try:
            up_r, up_w = await asyncio.open_connection("127.0.0.1", target, limit=1 << 22)
        except OSError as e:
            return await self.refuse(writer, f"the model's server is not answering ({e})", sent)
        try:
            out = [line] + [f"{k}: {v}" for k, v in headers if k.lower() not in HOP_HEADERS]
            up_w.write(("\r\n".join(out + [f"Content-Length: {len(body)}", "Connection: close"]) + "\r\n\r\n")
                       .encode("latin-1") + body)
            await up_w.drain()
            status_line, rh = await read_head(up_r)
            chunked = any(k.lower() == "transfer-encoding" and "chunked" in v.lower() for k, v in rh)
            if not sent:
                keep = [f"{k}: {v}" for k, v in rh if k.lower() not in ("connection", "keep-alive")]
                writer.write(("\r\n".join([status_line, *keep, "Connection: close"]) + "\r\n\r\n").encode("latin-1"))
                await self.pump(lambda: up_r.read(65536), reader, writer)
            elif status_line.split(" ")[1] != "200":
                text = (await up_r.read(65536)).decode(errors="replace").strip()
                await self.refuse(writer, f"the model answered {status_line.split(' ', 1)[1]}: {text[:1000]}", True)
            elif chunked:
                parts = dechunk(up_r)
                await self.pump(lambda: anext(parts, b""), reader, writer)
            else:
                await self.pump(lambda: up_r.read(65536), reader, writer)
        finally:
            up_w.close()

    async def pump(self, read, reader, writer):
        """Copies read() to the client until it ends, or until the client hangs up (closing the model's connection
        then cancels the request)."""
        gone, piece = asyncio.ensure_future(reader.read(1)), None
        try:
            while True:
                piece = piece or asyncio.ensure_future(read())
                done, _ = await asyncio.wait({piece, gone}, return_when=asyncio.FIRST_COMPLETED)
                if gone in done:
                    if not gone.result():
                        return
                    gone = asyncio.get_running_loop().create_future()
                if piece in done:
                    data, piece = piece.result(), None
                    if not data:
                        return
                    writer.write(data)
                    await writer.drain()
        finally:
            gone.cancel()
            if piece:
                piece.cancel()

    async def refuse(self, writer, why, sent):
        err = json.dumps({"error": {"message": why, "type": "b70_unavailable", "code": 503}}).encode()
        writer.write(b"data: " + err + b"\n\n" if sent else http_answer("503 Service Unavailable", err))
        await writer.drain()

    async def unloaded(self, writer, path):
        """A GET while the model is unloaded: discovery from the last load, health; anything else 503."""
        p = path.split("?")[0].rstrip("/")
        if p in ("/v1/models", "/models"):
            body = self.models or json.dumps(
                {"object": "list", "data": [{"id": self.name, "object": "model", "owned_by": "b70"}]}).encode()
            writer.write(http_answer("200 OK", body))
        elif p in ("/health", "/v1/health"):
            writer.write(http_answer("200 OK", b'{"status":"ok","model":"unloaded (standby)"}'))
        else:
            return await self.refuse(writer, "the model is unloaded while other work has the B70 (standby); a "
                                             "completion request loads it again", False)
        await writer.drain()


def standby_turn(owner, note, opts, first, gate, stop):
    """Waits for a turn on the B70 and returns its ticket; None without a queue daemon, or once `stop` is set. The first
    turn waits in line like any server's (never next in line, whatever the owner); later ones wait at the back until the
    card has been free a while (if this is the standby model that loaded last), and go to the back of the line like any
    job as soon as a request waits for the model."""
    body = {"owner": owner, "kind": "run", "argv": sys.argv, "cwd": os.getcwd(), "client_pid": os.getpid(),
            "note": note, "opts": dict(opts, when_free=not first)}
    try:
        tid = b70q("POST", "/api/tickets", body)["id"]
    except OSError:
        say("no b70q queue daemon; using the B70 without it")
        return None
    urgent, last, last_at, down_since = first, None, 0.0, None
    if not first:
        say(f"standing by (b70q #{tid}): the model loads again for the next request, or when the B70 is free and it "
            "is the standby model that loaded last")
    while True:
        if stop.is_set():
            try:
                b70q("POST", f"/api/tickets/{tid}/cancel", timeout=5)
            except OSError:
                pass
            return None
        if not urgent and gate.activity()[0]:
            try:
                b70q("POST", f"/api/tickets/{tid}/urgent", timeout=5)
                urgent = True
                say(f"a request is waiting for the model: in line for the B70 (b70q #{tid})")
            except OSError:
                pass
        try:
            w = b70q("GET", f"/api/tickets/{tid}/wait?until=granted&timeout=2", timeout=30)
            down_since = None
        except OSError as e:
            down_since = down_since or time.time()
            if time.time() - down_since > 300:
                say(f"lost the b70q daemon for 5 minutes ({e}); using the B70 without it")
                return None
            stop.wait(2)
            continue
        tk = w["ticket"]
        if tk["state"] == "granted":
            say(f"the B70 is ours (b70q #{tid} {owner})")
            return tid
        if tk["state"] != "waiting":
            if first:
                fail(f"b70q #{tid} {tk['state']} while waiting: {tk.get('end_reason')}", 75)
            say(f"b70q #{tid} {tk['state']} while waiting ({tk.get('end_reason')}); standing by again")
            stop.wait(5)
            return standby_turn(owner, note, opts, False, gate, stop)
        if urgent:
            msg = queue_wait_text(tid, w)
            if msg != last or time.time() - last_at >= 60:
                say(msg)
                last, last_at = msg, time.time()


def fetch_models(port):
    try:
        return urllib.request.urlopen(f"http://127.0.0.1:{port}/v1/models", timeout=5).read()
    except (OSError, http.client.HTTPException):
        return None


def rewarm(port, work, alive):
    """Reads the last request's prompt again (one token, answered to nobody), so the next request finds it in the
    model's prompt cache."""
    path, body = work
    try:
        req = json.loads(body)
    except ValueError:
        return
    for k in ("max_completion_tokens", "stream_options", "n"):
        req.pop(k, None)
    req.update(stream=True, return_progress=True, max_tokens=1)
    t0 = time.time()
    try:
        r = urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{port}{path}", json.dumps(req).encode(),
                                                          {"Content-Type": "application/json"}), timeout=1800)
        while r.read(65536):
            pass
        say(f"read the last request's prompt again in {time.time() - t0:.0f} s, so the next one finds it cached")
    except (OSError, http.client.HTTPException) as e:
        if alive():
            say(f"reading the last request's prompt again failed ({e})")


def serve_standby(a, args, ram_start, warm, record):
    """`serve --standby` (see above). Returns the exit code: 0 once asked to stop, the server's when it failed."""
    name = a.name or os.path.basename(os.path.abspath(a.model))
    note = f"b70 serve {name} (standby)"
    opts = {"server": True, "standby": True, "ram_gib": ram_start}
    queued = not os.environ.get("B70Q_TICKET")      # inside a queue job the card is that job's: never step aside
    gate, stop, current = Gate(a.port, name), threading.Event(), [None]

    def on_signal(*_):
        stop.set()
        if current[0]:
            threading.Thread(target=current[0].stop, args=("asked to stop", True), daemon=True).start()
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, on_signal)

    first = True
    while not stop.is_set():
        gate.clear()
        tid = standby_turn(a.queue, note, opts, first, gate, stop) if queued else None
        if stop.is_set():
            break
        guard = Guard(ram_start)
        problem = guard.problem()
        if problem:
            queue_done(tid, 98, problem)
            if first:
                fail(problem, 98 if guard.pci else 1)
            say(f"{problem}; trying again in a minute")
            gate.refuse_waiting(problem)
            stop.wait(60)
            continue
        if tid:
            os.environ["B70Q_TICKET"] = str(tid)    # the server's processes are this ticket's
        record(tid)
        urgent, starting, yielded = first or gate.activity()[0], [first], []
        clear_log()
        say(f"loading {name}" + (f"; http://127.0.0.1:{a.port}/v1 opens once it is warm" if first else " again"))

        def alive():
            return guard.proc.poll() is None and not guard.reason

        def report():
            # a first load counts as in use until it is warm: its caller is waiting for the port to open
            while alive() and not stop.is_set():
                busy, idle = gate.activity()
                try:
                    r = b70q("POST", f"/api/tickets/{tid}/activity", {"busy": busy or starting[0], "idle_s": idle},
                             timeout=5)
                except OSError:
                    r = {}
                if r.get("yield") and gate.close():
                    yielded.append(r.get("reason") or "yielded")
                    guard.stop(f"{yielded[0]}: unloading until the B70 is free", expected=True)
                    return
                time.sleep(3)

        def ready():
            if tid:
                threading.Thread(target=report, daemon=True).start()
            if not wait_warm(a, warm, alive):
                return
            gate.open(a.inner_port, fetch_models(a.inner_port), touch=starting[0])
            if starting[0]:
                try:
                    gate.listen()
                except OSError as e:
                    guard.stop(f"can't open port {a.port}: {e}")
                    return
                say(f"ready on http://127.0.0.1:{a.port}/v1 (standby: unloads while other work needs the B70)")
            else:
                say("loaded again")
            starting[0] = False
            if not urgent and gate.last_work:
                rewarm(a.inner_port, gate.last_work, alive)

        current[0] = guard
        rc = guard.run(args, ready, signals=False)
        current[0] = None
        gate.close(force=True)
        os.environ.pop("B70Q_TICKET", None)
        if stop.is_set():
            queue_done(tid, 0)
            break
        if yielded:
            queue_done(tid, 0, yielded[0])     # a process of the server still on the card holds the next job (leftover)
            first = False
            continue
        # the server ended on its own: the guard stopped it (a fault, low RAM) or it crashed
        gate.refuse_waiting(f"the model's server stopped (exit {rc})")
        queue_done(tid, rc)
        return rc or 1
    return 0


