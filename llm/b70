    cmd = [exe, "--host", "127.0.0.1", "--port", str(a.inner_port), "--cache", str(ctx), "--model-dir", model,
           "--served-name", a.name or "glm-5.3-flash", "--store", blob]
    lora = sorted(n for n in os.listdir(model) if (n == "lora" or n.startswith("lora-"))
                  and os.path.isfile(os.path.join(model, n, "adapter_config.json")))
    # the tier as for serve.py; the engine's other host memory is the 4.5 GB memfd prompt ring and ~3 GB of process
    ram = a.ram_gb or max(12, min(22, int(avail_gb() - 19)))
    cmd += ["--ram-gb", str(ram)]
    if lora:
        cmd += ["--lora", ",".join(os.path.join(model, n) for n in lora)]
    env = {k: v for k, v in env.items() if k.startswith(("GLM_XPU_RES_BONUS", "GLM_XPU_LORA_SCALE", "GLM_SERVE_", "GLM_PF2"))}
    env.update({k: v for k, v in os.environ.items() if k.startswith("GLM_PF2")})
    env["ONEAPI_DEVICE_SELECTOR"] = "level_zero:gpu"
    return ["env"] + [f"{k}={v}" for k, v in sorted(env.items())] + cmd, int(ram + 10), \
        {"model": a.name or "glm-5.3-flash", "messages": [{"role": "user", "content": "Hello."}], "max_tokens": 1}


